{
  "name": "compus-baseball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:quick": "vitest run --maxWorkers=2",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "test:watch": "vitest",
    "bench": "vitest bench --run --maxWorkers=1 --project \"node (bench)\" --reporter=default",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:lines && pnpm check:boundaries && pnpm knip && pnpm test:quick && pnpm build && pnpm size",
    "test:area": "node tools/test-area.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:lines": "node tools/check-lines-baseline.mjs",
    "check:boundaries": "node tools/check-boundaries-baseline.mjs",
    "knip": "knip --no-progress",
    "size": "size-limit",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "jotai": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stats.js": "0.17.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@size-limit/file": "13.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tweakpane/core": "2.0.5",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/stats.js": "0.17.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "21.0.4",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "size-limit": "13.1.1",
    "tweakpane": "4.0.5",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18 <25"
  }
}
