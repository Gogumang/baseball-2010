{
  "name": "compus-baseball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:quick": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:lines && pnpm test && pnpm build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "e2e:hits": "node e2e/hits.mjs",
    "e2e:all": "node e2e/all.mjs",
    "e2e:quick": "node e2e/quick.mjs",
    "e2e:only": "node e2e/only.mjs",
    "e2e:measure": "node e2e/measure.mjs",
    "test:area": "node tools/test-area.mjs",
    "e2e:snapshot": "node e2e/snapshot.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:lines": "node tools/check-lines-baseline.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^25.0.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18 <25"
  }
}
