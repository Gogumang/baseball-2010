{
  "name": "compus-baseball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:quick": "vitest run --exclude src/app/model/soak/careerSoak.test.tsx --exclude src/app/model/soak/pitcherLeagueSoak.test.tsx",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "yarn typecheck && yarn lint && yarn format:check && yarn check:lines && yarn test && yarn build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "e2e:hits": "node e2e/hits.mjs",
    "e2e:all": "node e2e/all.mjs",
    "e2e:quick": "node e2e/quick.mjs",
    "e2e:only": "node e2e/only.mjs",
    "e2e:measure": "node e2e/measure.mjs",
    "test:area": "node tools/test-area.mjs",
    "e2e:snapshot": "node e2e/snapshot.mjs",
    "e2e:fixtures": "SOAK_FIXTURE=1 vitest run src/app/model/soak/soakFixtures.test.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:lines": "node tools/check-lines-baseline.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "^25.0.1",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
