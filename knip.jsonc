// knip — 안 쓰는 파일 · export · 의존성 찾기 (`pnpm knip`, r366).
// 진입점은 플러그인이 찾는다: Vite(index.html → src/app/main.tsx · vite.config.ts) · Vitest(시험 파일 · setupFiles) ·
// lefthook · size-limit · oxlint(jsPlugins) · package.json 스크립트(tools/*.mjs). 아래 `entry` 는 그 밖의 것만.
// 새 예외는 이유를 적어 여기에만 넣는다 — 지울 수 있게 되면 목록에서 뺀다(줄어들기만).
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // 빌드가 파일 경로로 복사해 내보내는 서비스 워커 (`tools/viteAssetPacks.ts` → 산출물 `asset-sw.js`)
    "tools/assetPackServiceWorker.js",
  ],
  "project": ["src/**/*.{ts,tsx}", "tools/**/*.{mjs,ts,js}", "*.{ts,js}"],
  // 같은 파일 안에서 쓰는 export 는 세지 않는다 — 시험 · 다른 화면이 꺼낼 수 있게 열어 둔 것이 많고(첫 실행 651개),
  // 하나하나 `export` 를 떼는 것은 동작과 무관한 큰 변경이라 따로 한다
  "ignoreExportsUsedInFile": true,
  // tweakpane 4 의 타입(.d.ts)이 @tweakpane/core 를 import 하지만 tweakpane package.json 에 의존성으로 안 적혀 있어 직접 깐다
  "ignoreDependencies": ["@tweakpane/core"],
  "ignoreIssues": {
    // ── 원본 기록 상수: 원본 주소 · 표 · 글 번호 · 바이트 값을 이름으로 남긴 것. 아직 부르는 곳이 없거나 같은 값을 다른 길로 쓴다
    "src/entities/batting/model/batter.ts": ["exports"], // ABILITY_SCALE (generate_game_data.py 가 같은 눈금을 쓴다)
    "src/entities/career/model/battingOrder.ts": ["exports"], // START_BATTING_ORDER
    "src/entities/career/model/gpItems.ts": ["exports"], // EAGLE_EYE_NOTICE · EAGLE_EYE_ITEM_ID (StrMODE[224], 0x13ab4)
    "src/entities/career/model/gpItems/guard/guard.ts": ["exports"], // EAGLE_EYE_NOTICE · EAGLE_EYE_ITEM_ID (위 모음이 다시 내보낸다)
    "src/entities/career/model/seasonFlow/endingAftermath.ts": ["exports"], // ENDING_EVENT_IDS
    "src/entities/defense-controls/model/laserThrow.ts": ["exports"], // LASER_SPEED_PERCENT · LASER_RANGE_PERCENT · LASER_WILD_THROW_BONUS
    "src/entities/defense-controls/model/pickoff.ts": ["exports"], // PICKOFF_AI_STATE (0xb47da)
    "src/entities/defense-controls/model/sliding.ts": ["exports"], // SLIDING_MOTION
    "src/entities/defense-controls/model/vibration.ts": ["exports"], // EVENT_VIBRATION_MILLISECONDS (0x8cece)
    "src/entities/fielding/model/cpuSteal.ts": ["exports"], // CPU_STEAL_DECISION_TICK · CPU_BATTER_DECISION_TICK
    "src/entities/home-run-derby/model/derbyRules.ts": ["exports"], // NEW_RECORD_SOUND_ID · NORMAL_RECORD_SOUND_ID (0x4f644)
    "src/entities/league/model/leagueDay.ts": ["exports"], // REGULAR_INNINGS · LEAGUE_DAY_GAME_COUNT
    "src/entities/national-cup/model/nationalCup.ts": ["exports"], // NATIONAL_CUP_FULL_STAMINA
    "src/entities/pitcher-career/model/magicPitch/names.ts": ["exports"], // MAGIC_PITCH_NAME_STRING_INDEX (StrCOMMON)
    "src/entities/pitcher-career/model/managerHook.ts": ["exports"], // SELF_HOOK_PROMPT_GAME_TEXT_INDEX · HOOK_SCENE_STATE
    "src/entities/pitcher-career/model/pitcherAbility.ts": ["exports", "duplicates"], // PITCHER_ABILITY_ITEM_TEXT_INDEX · 아이템 대상 = 능력치 차례 (같은 표의 두 이름)
    "src/entities/pitcher-career/model/pitcherRegistration.ts": ["exports"], // PITCHER_RECORD_BYTE_0X0A
    "src/entities/pitcher-career/model/pitcherRotation.ts": ["exports"], // LAST_INNING_INDEX (state+0x69)
    "src/entities/pitcher-career/model/pitcherStamina.ts": ["exports"], // HOME_RUN_DERBY_MODE (0xaebb0) · STAMINA_TONIC_TEXT (StrMODE)
    "src/entities/pitcher-career/model/pitchTraining.ts": ["exports"], // PITCH_TRAINING_COLUMN_COUNT
    "src/entities/season-mode/model/seasonAttendance.ts": ["exports"], // STORE_GAMES_ON_PURCHASE
    "src/entities/season-mode/model/seasonEventFlow.ts": ["exports"], // SEASON_SCREEN_CODE · ILLNESS_ABILITY_PENALTY_PERCENT (b5824)
    "src/entities/season-mode/model/seasonEventFlow/ids.ts": ["exports"], // SEASON_SCREEN_CODE (위 모음이 다시 내보낸다)
    "src/entities/season-mode/model/seasonEventFlow/illness.ts": ["exports"], // ILLNESS_ABILITY_PENALTY_PERCENT (b5824, 위 모음이 다시 내보낸다)
    "src/entities/season-mode/model/seasonGoals.ts": ["exports"], // SEASON_GOAL_INTRO_EVENT_ID
    "src/entities/season-mode/model/seasonItemShop/prices.ts": ["exports"], // SEASON_SHOP_SLOT_COUNT
    "src/entities/season-mode/model/seasonReputation.ts": ["exports"], // UNUSED_SLOT (S[15])
    "src/entities/season-mode/model/stadiumItems.ts": ["exports"], // GRASS_HAS_NO_EFFECT (없는 게 원본과 같다는 표시)
    "src/entities/settings/model/modeReset.ts": ["exports"], // MODE_RESET_SLOT (0x224ec)
    "src/features/play-game/model/benchClearingScene.ts": ["exports"], // BENCH_CLEARING_TRANSITION_TICK
    "src/features/play-game/model/halfInningBoard.ts": ["exports"], // HALF_INNING_SCOREBOARD_TICK (0x4ff00)
    "src/features/play-pitcher-game/model/pitcherPitch/zone.ts": ["exports"], // STRIKE_ZONE_RECTS (0xcfb7c) · ZONE_CENTER_POINTS (0xcfb54)
    "src/features/play-team-game/model/gameAbilities/coach.ts": ["exports"], // NO_COACH
    "src/features/play-team-game/model/gameAbilities/seasonPenalties.ts": ["exports"], // ALL_POSITION_SKILL_ID (0xb62b4(p, 0x15))
    "src/features/play-team-game/model/teamGameFlow/setup/savePoint.ts": ["exports"], // TEAM_GAME_RESUME_SAVE
    "src/pages/defense/lib/defenseCamera.ts": ["exports"], // CAMERA_ENDING_FOLLOW_PERCENT (0xc0558)
    "src/pages/defense/lib/defenseView.ts": ["exports"], // LASER_SHINE_COLOR · LASER_SHINE_EFFECT_KIND
    "src/pages/defense/lib/fieldMap.ts": ["exports"], // MAP_COLORS (0x39680)
    "src/pages/record/lib/recordAnnalsLayout.ts": ["exports"], // SEASON_ENDING_CELL_COUNT
    "src/pages/record/lib/recordAnnalsLayout/annalsProgress.ts": ["exports"], // SEASON_ENDING_CELL_COUNT (barrel 이 다시 내보낸다)
    "src/pages/record/lib/recordDescriptions.ts": ["exports"], // RECORD_DESCRIPTION_FIRST_ID (StrGAME[0x38])
    "src/pages/settings/lib/settingsLayout.ts": ["exports"], // ROW_SHAKE_TABLES (0xd1784 · 0xd1754)
    "src/pages/settings/lib/settingsLayout/settingsSubPages.ts": ["exports"], // ROW_SHAKE_TABLES (barrel 이 다시 내보낸다)
    "src/pages/shop/lib/shopLayout.ts": ["exports"], // STADIUM_BOXES · STADIUM_COLORS (구장 아이템 화면 — 웹 미구현, 좌표만)
    "src/pages/story/lib/evaluationChangeWindow.ts": ["exports"], // SYSTEM_EVALUATION_CHANGE_WINDOW
    "src/widgets/entry-editor/lib/entryListWindow.ts": ["exports"], // ENTRY_VISIBLE_ROWS (0x55798)
    "src/widgets/scoreboard-frame/lib/scoreboardFrameLayout.ts": ["exports"], // NAME_PLATE_ROUND · INTRO_SCENE_STATE
    "src/widgets/season/lib/seasonEndingLayout.ts": ["exports"], // SEASON_ENDING_COUNT · CREDITS_TEXT_INDEX

    // ── 원본 함수를 옮겨 두었지만 아직 부르는 곳이 없는 것 (원본 근거 주석이 붙어 있다)
    "src/entities/fielding/model/rundown.ts": ["exports"], // fielderRemainingTicks (0xbefec)
    "src/entities/fielding/model/throwTargetBase.ts": ["exports"], // baseAtPoint (0xb1268)
    "src/entities/fielding/model/throwTargetBase/specialThrow.ts": ["exports"], // baseAtPoint (0xb1268, 위 모음이 다시 내보낸다)
    "src/entities/mission/model/missionGame.ts": ["exports"], // simulateMissionAutoHalf · simulateHumanTeamAutoHalf (틱 꼴을 끝까지 — 자동진행 0x21 설명)
    "src/entities/mission/model/missionGame/auto/autoHalf.ts": ["exports"], // simulateMissionAutoHalf (위 모음이 다시 내보낸다)
    "src/entities/mission/model/missionGame/auto/humanTeamAutoHalf.ts": ["exports"], // simulateHumanTeamAutoHalf (위 모음이 다시 내보낸다)
    "src/entities/pitcher-career/model/pitcherTitles.ts": ["exports"], // isPitcherOnlyTitleNumber
    "src/entities/season-mode/model/entryEditor.ts": ["exports"], // fieldPositionLabelOf (레코드 +0x1c 위치 코드)
    "src/entities/season-mode/model/entryEditor/labels.ts": ["exports"], // fieldPositionLabelOf (위 모음이 다시 내보낸다)
    "src/features/defense-play/model/walkPlay.ts": ["exports"], // walkPitchJudgementOf (0x3e1ae)
    "src/features/play-team-game/model/teamGameRoster.ts": ["exports"], // quickBatterFor · quickPitcherFor · stageBatterAbility · stagePitcherAbility (0xb62b4 경기 능력치 조립)
    "src/features/play-team-game/model/teamGameRoster/rosterAbilities.ts": ["exports"], // quickBatterFor · stageBatterAbility · stagePitcherAbility (위 모음이 다시 내보낸다)
    "src/pages/create-player/lib/teamSelectLayout.ts": ["exports", "duplicates"], // abilityChartMaximumOf (0x76424 — 웹은 안 그림) · 나만의리그 칸 = 팀 칸
    "src/pages/help/lib/helpLayout.ts": ["exports"], // RANKING_TITLE_FRAMES (0xcedf4) · rowLeftOf (0x253d4)
    "src/pages/management/lib/nariMatchPrepare/matchAces.ts": ["exports"], // nariGameAcesOf (0xb8870)
    "src/shared/lib/commonWindow/sceneMarks.ts": ["exports"], // gameSceneFreezeSerialNow (52efe)
    "src/shared/lib/liveGameState/liveGameState.ts": ["exports"], // isLiveGameLosingTeam (0xb6a4c · 0xb6be8)
    "src/shared/lib/skinTicker/skinTicker.ts": ["exports", "duplicates"], // clearSkinTickerCounter — 대전(0x31c60)이 부를 자리, 웹에 대전이 없다
    "src/widgets/season/lib/seasonAwardEvents.ts": ["exports"], // seasonAwardRewardOf (보상 표) · SEASON_PITCHER_TITLE_KINDS

    // ── 나중에 쓸 진행 상태 길: 호감도 · 게임포인트 · 이번 시즌 훈련 합계 (저장 칸은 이미 있다)
    "src/entities/career/model/playerCareer.ts": ["exports"], // seasonTrainingTotalOf · gainAffection
    "src/entities/pitcher-career/model/pitcherCareer.ts": ["exports"], // gainPitcherGamePoint · gainPitcherAffection

    // ── 원본 버그 고치기 · 해금 설정 도우미 (설정 화면 · 측정 도구가 쓸 자리)
    "src/shared/config/bugfixes/bugfixes.ts": ["exports"], // ORIGINAL_BUG_COUNT · activeBugfixConfig
    "src/shared/config/unlocks/unlocks.ts": ["exports"], // activeUnlockConfig

    // ── 생성기가 원본에서 만드는 표 — 직접 고치지 않는다 (tools/generate_game_data.py)
    "src/shared/config/original/**": ["exports", "types"],

    // ── 원본 구조를 주석으로 적어 둔 타입
    "src/entities/career/model/equipment.ts": ["types"], // EquipmentLevels (장착 아이템 표 0xcc444 · 0xd8890 설명)
    "src/entities/season-mode/model/playerRecruit.ts": ["types", "duplicates"], // RecruitListCode · 같은 바이트의 두 이름

    // ── 같은 값의 두 이름 (원본 칸 하나를 두 쓰임새로 부른다)
    "src/features/defense-play/model/representativePattern.ts": ["duplicates"],
    "src/pages/main-menu/lib/mainMenuLayout.ts": ["duplicates"],

    // ── 시험이 `vi.importActual(...)` 결과에서 이름으로 꺼낸다(정적 분석이 못 본다)
    "src/widgets/screen-frame/model/useListPageEntry.ts": ["exports"], // settledListPageEntry
  },
}
